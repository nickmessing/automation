# A "server" to configure and deploy to: Fedora with systemd as PID 1 and sshd.
# Podman runs systemd containers natively; for Docker see compose.docker.yaml.
FROM registry.fedoraproject.org/fedora:44

# python3 + libdnf5 let ansible manage packages, sudo lets it become root
RUN dnf -y install --setopt=install_weak_deps=False \
        systemd openssh-server sudo python3 python3-libdnf5 procps-ng \
 && dnf clean all

RUN useradd --create-home --shell /bin/bash ansible \
 && install -d -m 700 -o ansible -g ansible /home/ansible/.ssh \
 && echo 'ansible ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/ansible \
 && chmod 440 /etc/sudoers.d/ansible

COPY test_server/sshd.conf /etc/ssh/sshd_config.d/10-lab.conf

# only sshd is needed at boot; ansible installs and starts the rest
RUN systemctl enable sshd \
 && systemctl mask systemd-logind.service getty.target console-getty.service systemd-firstboot.service

EXPOSE 22 80
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
