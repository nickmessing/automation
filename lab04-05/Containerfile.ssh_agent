# Jenkins SSH agent with a pinned Rust toolchain (lab04's "php-agent", for Rust)
FROM docker.io/jenkins/ssh-agent:9.0.0-jdk21

ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
# keep in sync with app/rust-toolchain.toml
ARG RUST_VERSION=1.98.1
ARG NEXTEST_VERSION=0.9.146
ARG NEXTEST_SHA256=682c21b777c333e96fd532e114d3a5a894e0729ab88d94c0a9f20f8419695428

# the entrypoint copies variables with a "_" into /etc/environment for ssh sessions
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSLo /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init"; \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" --component rustfmt,clippy; \
    rm /tmp/rustup-init; \
    curl -fsSLo /tmp/nextest.tar.gz "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${NEXTEST_VERSION}/cargo-nextest-${NEXTEST_VERSION}-x86_64-unknown-linux-gnu.tar.gz"; \
    echo "${NEXTEST_SHA256}  /tmp/nextest.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/nextest.tar.gz -C "${CARGO_HOME}/bin"; \
    rm /tmp/nextest.tar.gz; \
    # builds run as jenkins and download crates into CARGO_HOME
    chown -R jenkins:jenkins "${CARGO_HOME}"; \
    PATH="${CARGO_HOME}/bin:${PATH}" cargo --version; \
    PATH="${CARGO_HOME}/bin:${PATH}" cargo nextest --version
