# build from the repo root, so lab02.nu is reused rather than copied:
#   podman build -f lab03/Containerfile -t automation-lab03 .
FROM registry.fedoraproject.org/fedora:44

ARG NU_VERSION=0.113.1
ARG NU_SHA256=7faea21f8a49edf760c7bb9267f7702827937b19fc7dce412716b1cacbf38ae7
ARG SUPERCRONIC_VERSION=v0.2.49
ARG SUPERCRONIC_SHA256=a53ae236602c7338aba3fbaff40bda6300eae3b9fedb8261eb06cfe3724430c1

LABEL org.opencontainers.image.title="automation-lab03" \
      org.opencontainers.image.description="Scheduled exchange rate fetcher (nushell + supercronic)" \
      org.opencontainers.image.source="https://github.com/nickmessing/automation"

RUN dnf -y install --setopt=install_weak_deps=False tzdata \
 && dnf clean all

RUN set -eux; \
    nu_dir="nu-${NU_VERSION}-x86_64-unknown-linux-musl"; \
    curl -fsSLo /tmp/nu.tar.gz "https://github.com/nushell/nushell/releases/download/${NU_VERSION}/${nu_dir}.tar.gz"; \
    echo "${NU_SHA256}  /tmp/nu.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/nu.tar.gz -C /usr/local/bin --strip-components=1 "${nu_dir}/nu"; \
    rm /tmp/nu.tar.gz; \
    curl -fsSLo /usr/local/bin/supercronic "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-amd64"; \
    echo "${SUPERCRONIC_SHA256}  /usr/local/bin/supercronic" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/supercronic

RUN groupadd --gid 10001 rates \
 && useradd --uid 10001 --gid rates --create-home --home-dir /home/rates rates \
 && install -d -o rates -g rates /var/lib/rates /var/log/lab03

COPY lab02.nu /app/lab02.nu
COPY lab03/scheduler.nu /app/lab03/scheduler.nu

ENV TZ=Europe/Chisinau \
    LAB02_ROOT=/var/lib/rates \
    LOG_FILE=/var/log/lab03/cron.log \
    RUN_ON_START=true

VOLUME ["/var/lib/rates", "/var/log/lab03"]
USER rates
WORKDIR /home/rates

# supercronic serves /metrics on 127.0.0.1:9746 while it is running
HEALTHCHECK --interval=1m --timeout=5s --start-period=2m \
    CMD curl -fsS -o /dev/null http://127.0.0.1:9746/metrics || exit 1

ENTRYPOINT ["nu", "/app/lab03/scheduler.nu", "start"]
